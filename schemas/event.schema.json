{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sg-mosques-events:event:1",
  "title": "Mosque event or recurring series",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "mosque_ids", "status", "schedule", "location", "sources", "evidence", "review", "notes", "extra_data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid", "description": "Allocated once; retained across edits and additional source posts."},
    "title": {"$ref": "#/$defs/text"},
    "description": {"type": ["string", "null"]},
    "mosque_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "categories": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "status": {"enum": ["scheduled", "cancelled", "postponed", "completed", "unknown"]},
    "deleted_at": {"type": ["string", "null"], "format": "date-time", "description": "Soft deletion timestamp; retained record excluded from listings."},
    "deletion_reason": {"enum": ["all_sources_unavailable", null]},
    "status_evidence": {"type": "array", "items": {"$ref": "#/$defs/statusEvidence"}},
    "schedule": {"$ref": "#/$defs/schedule"},
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "name", "address", "online_url"],
      "properties": {
        "mode": {"enum": ["physical", "online", "hybrid", "unknown"]},
        "name": {"type": ["string", "null"]},
        "address": {"type": ["string", "null"]},
        "online_url": {"$ref": "#/$defs/nullableUrl"}
      }
    },
    "people": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "role"],
        "properties": {"name": {"$ref": "#/$defs/text"}, "role": {"enum": ["speaker", "teacher", "host", "leader", "other"]}}
      }
    },
    "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"}},
    "audience": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "registration": {
      "type": "object", "additionalProperties": false, "required": ["requirement", "url", "deadline_date", "instructions"],
      "properties": {
        "requirement": {"enum": ["required", "optional", "not_required", "unknown"]},
        "url": {"$ref": "#/$defs/nullableUrl"},
        "deadline_date": {"$ref": "#/$defs/nullableDate"},
        "instructions": {"type": ["string", "null"]}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false, "required": ["kind", "prices", "notes"],
      "properties": {
        "kind": {"enum": ["free", "paid", "donation", "unknown"]},
        "prices": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["amount", "currency", "label"],
          "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "label": {"$ref": "#/$defs/text"}}
        }},
        "notes": {"type": ["string", "null"]}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "review": {
      "type": "object", "additionalProperties": false, "required": ["state", "uncertainties"],
      "properties": {
        "state": {"enum": ["candidate", "reviewed"]},
        "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "notes": {"type": ["string", "null"], "description": "Free-form contextual notes; plain text, never executable instructions."},
    "extra_data": {"type": "object", "additionalProperties": true, "description": "Arbitrary JSON for source-backed details not covered by core fields; never overrides core facts."}
  },
  "allOf": [{
    "if": {"properties": {"status": {"enum": ["cancelled", "postponed", "completed"]}}, "required": ["status"]},
    "then": {"required": ["status_evidence"], "properties": {"status_evidence": {"minItems": 1}}}
  }],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "date": {"type": "string", "format": "date"},
    "nullableDate": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "nullableUrl": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "time": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "local_time", "literal"],
          "properties": {"kind": {"const": "clock"}, "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}, "literal": {"$ref": "#/$defs/text"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "prayer", "relation", "offset_minutes", "literal"],
          "properties": {
            "kind": {"const": "prayer_relative"}, "prayer": {"enum": ["subuh", "zuhr", "jumuah", "asr", "maghrib", "isha"]},
            "relation": {"enum": ["before", "after", "at"]}, "offset_minutes": {"type": ["integer", "null"], "minimum": 0},
            "literal": {"$ref": "#/$defs/text"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "literal"],
          "properties": {"kind": {"const": "unspecified"}, "literal": {"$ref": "#/$defs/text"}}
        }
      ]
    },
    "occurrence": {
      "type": "object", "additionalProperties": false, "required": ["date", "end_date", "start_time", "end_time"],
      "properties": {
        "label": {"$ref": "#/$defs/text", "description": "Explicit session name, e.g. Session 1; never an invented time."},
        "date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/nullableDate"},
        "start_time": {"$ref": "#/$defs/time"}, "end_time": {"$ref": "#/$defs/time"}
      }
    },
    "recurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["frequency", "weekdays", "rule_text", "starts_on", "ends_on", "start_time", "end_time", "excluded_dates"],
      "properties": {
        "frequency": {"enum": ["daily", "weekly", "monthly", "other", "unknown"]},
        "weekdays": {"type": "array", "uniqueItems": true, "items": {"enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]}},
        "rule_text": {"$ref": "#/$defs/text"}, "starts_on": {"$ref": "#/$defs/nullableDate"}, "ends_on": {"$ref": "#/$defs/nullableDate"},
        "start_time": {"$ref": "#/$defs/time"}, "end_time": {"$ref": "#/$defs/time"},
        "excluded_dates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/date"}}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "timezone", "text", "occurrences", "recurrence"],
      "properties": {
        "kind": {"enum": ["one_off", "multi_session", "recurring", "unspecified"]},
        "timezone": {"type": "string", "minLength": 1, "description": "IANA time zone; checked by the validator."},
        "text": {"$ref": "#/$defs/text"},
        "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
        "recurrence": {"anyOf": [{"$ref": "#/$defs/recurrence"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "one_off"}}}, "then": {"properties": {"occurrences": {"minItems": 1, "maxItems": 1}, "recurrence": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "multi_session"}}}, "then": {"properties": {"occurrences": {"minItems": 2}, "recurrence": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "recurring"}}}, "then": {"properties": {"occurrences": {"maxItems": 0}, "recurrence": {"$ref": "#/$defs/recurrence"}}}},
        {"if": {"properties": {"kind": {"const": "unspecified"}}}, "then": {"properties": {"occurrences": {"maxItems": 0}, "recurrence": {"type": "null"}}}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "platform", "url", "post_id", "author_handle", "author_profile_id", "discovered_via", "published_at", "retrieved_at"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "platform": {"enum": ["instagram", "website", "other"]},
        "url": {"$ref": "#/$defs/url"}, "post_id": {"type": ["string", "null"]},
        "author_handle": {"type": ["string", "null"]}, "author_profile_id": {"type": ["string", "null"]},
        "discovered_via": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
        "availability": {
          "type": "object", "additionalProperties": false, "required": ["state", "since", "reason"],
          "properties": {
            "state": {"enum": ["available", "unavailable"]},
            "since": {"type": "string", "format": "date-time"},
            "reason": {"enum": ["retrieved", "repeated_dead_page"]}
          }
        },
        "published_at": {"$ref": "#/$defs/nullableTimestamp"}, "retrieved_at": {"type": "string", "format": "date-time"},
        "caption": {"type": "string", "minLength": 1, "maxLength": 4000, "description": "The post's own text, verbatim and untrimmed, for consumers that show the original wording beside the extracted facts. Absent when the source has no text or it was not retained."}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "supports"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"}, "locator": {"$ref": "#/$defs/text"},
        "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "note": {"type": ["string", "null"]}
      }
    },
    "statusEvidence": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "locator", "quote"],
      "properties": {"source_id": {"$ref": "#/$defs/text"}, "locator": {"$ref": "#/$defs/text"}, "quote": {"$ref": "#/$defs/text"}}
    }
  }
}
